<div
  id="customizer-block"
  style="display:none;"
>
  <button
  id="open-customizer"
    type="button"
      data-product-id="{{ product.id }}"
data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    style="
      background:black;
      color:white;
      padding:12px 20px;
      border:none;
      cursor:pointer;
      font-size:16px;
    "
  >
    Customize Product
  </button>
</div>

<div
  id="customizer-modal"
  style="
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100vw;
    height:100vh;
    background:rgba(0,0,0,.6);
    z-index:999999;
    justify-content:center;
    align-items:center;
  "
>
<div
  style="
    width:90%;
    max-width:1200px;
    height:700px;
    background:white;
    position:relative;
    border-radius:10px;
  "
>
    <button
      id="close-customizer"
      style="
          position: absolute;
    top: 20px;
    right: 20px;
    z-index: 999999;
    background: #000;
    color: #fff;
    padding: 7px 10px;
    border-radius: 5px;

      "
    >
      X
    </button>
      
  <iframe
  id="designer-frame"
    src=""
    style="
      width:100%;
      height:100%;
      border:none;
    "
  ></iframe>
  </div>
</div>

<script>
const APP_URL =
  "https://explicitly-marking-newsletters-medal.trycloudflare.com";
</script>
<script>
(async function () {
  const productId = "{{ product.id }}";

  try {
    const response = await fetch(
  "/apps/customizer?productId=" +
  productId +
  "&shop=" +
  Shopify.shop
)

    const data = await response.json();

    console.log(data);

    if (data.customizable) {
      document.getElementById(
        "customizer-block"
      ).style.display = "block";
    }
  } catch (err) {
    console.error(err);
  }
})();
</script>

<script>
document.addEventListener("click", (e) => {
if (e.target.id === "open-customizer") {

  const productId =
    e.target.dataset.productId;

  const variantId =
    document.querySelector(
      'input[name="id"]'
    )?.value;

  console.log("Product ID:", productId);
  console.log("Variant ID:", variantId);

  document.getElementById(
    "designer-frame"
  ).src =
    APP_URL +
    "/designer?productId=" +
    productId +
    "&variantId=" +
    variantId +
    "&shopUrl=" +
    encodeURIComponent(
      window.location.origin
    );

  document.getElementById(
    "customizer-modal"
  ).style.display = "flex";
}
 if (e.target.id === "close-customizer") {

  document.getElementById(
    "designer-frame"
  ).src = "";

  document.getElementById(
    "customizer-modal"
  ).style.display = "none";
}
});
</script>
<script>
window.addEventListener("message", async (event) => {

  if (event.data.type !== "ADD_TO_CART")
    return;

  await fetch("/cart/add.js", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      items: [
        {
          id: event.data.variantId,
          quantity: event.data.quantity,
properties: {
  Size: event.data.selectedSize,

  ...(event.data.frontImage && {
    Front: event.data.frontImage,
  }),

  ...(event.data.backImage && {
    Back: event.data.backImage,
  }),

  ...(event.data.leftImage && {
    Left: event.data.leftImage,
  }),

  ...(event.data.rightImage && {
    Right: event.data.rightImage,
  }),
},
        },
      ],
    }),
  });

  window.location.href = "/cart";
});
</script>
{% schema %}
{
  "name": "Product Customizer",
  "target": "section",
  "settings": []
}
{% endschema %}